{
  "name": "cinecode-studio",
  "productName": "Cinecode Studio",
  "version": "0.2.0",
  "description": "cinecode skill'i için masaüstü uygulaması: fikrini yaz, Claude filmi kodla üretsin.",
  "main": "src/main/main.mjs",
  "type": "module",
  "author": "İsmail Yıldız",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main/tools.mjs && node --check src/main/main.mjs && node --check src/main/session.mjs && node --check src/main/settings.mjs && node --check src/main/skill.mjs && node --check src/main/projects.mjs && node --check src/main/requirements.mjs && node --check src/preload.cjs && node --check src/renderer/app.js && node test/smoke.mjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.cinecode.studio",
    "productName": "Cinecode Studio",
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Cinecode-Studio-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cinecode Studio",
      "runAfterFinish": true
    }
  }
}
